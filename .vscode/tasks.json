{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "PlatformIO: Build ESP32",
			"type": "shell",
			"command": "${env:HOME}/.platformio/penv/bin/platformio",
			"args": [
				"run",
				"-e",
				"esp32dev"
			],
			"isBackground": false,
			"problemMatcher": [
				"$gcc"
			],
			"group": "build"
		}
	]
}